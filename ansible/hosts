[routers]
router1 ansible_host=192.168.250.10 ansible_user=vagrant ansible_ssh_private_key_file=/home/vagrant/.ssh/lab_ed25519 router_id=1.1.1.1
router2 ansible_host=192.168.250.11 ansible_user=vagrant ansible_ssh_private_key_file=/home/vagrant/.ssh/lab_ed25519 router_id=2.2.2.2
router3 ansible_connection=local router_id=3.3.3.3

[routers:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
